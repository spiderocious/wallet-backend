# Copy to .env for local development. Every variable the process reads is here.
APP_ENV=development
PORT=8081
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5174,http://localhost:4174
DATA_DIR=./data
DEMO_CONTROL=false
LOG_LEVEL=info
